{
  "name": "fan-zhang",
  "version": "0.9.0",
  "private": true,
  "description": "次元刻度 · 个人动画观看账本（本地优先 / 零第三方依赖 / 桌面独立窗口）",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.js --open",
    "start": "node --disable-warning=ExperimentalWarning server/index.js --open",
    "start:headless": "node --disable-warning=ExperimentalWarning server/index.js --no-open",
    "build": "node --check server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "test:repos": "node --disable-warning=ExperimentalWarning --test tests/repositories.test.js",
    "test:http": "node --disable-warning=ExperimentalWarning --test tests/http.test.js",
    "test:media": "node --disable-warning=ExperimentalWarning --test tests/seasonal_and_media.test.js tests/compliance_and_antipitfall.test.js"
  }
}
